<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HDLForge — Hardware Design Interview Prep</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
  <style>
    :root {
      --bg-primary: #0d1117;
      --bg-secondary: #161b22;
      --bg-tertiary: #21262d;
      --border: #30363d;
      --text-primary: #e6edf3;
      --text-secondary: #8b949e;
      --accent-blue: #58a6ff;
      --accent-green: #238636;
      --accent-green-light: #3fb950;
      --accent-yellow: #d29922;
      --accent-red: #f85149;
      --accent-purple: #a371f7;
      --accent-pink: #f778ba;
      --radius: 12px;
      --radius-sm: 8px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
    }

    /* ===== NAVBAR ===== */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(13, 17, 23, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 24px;
    }
    .navbar-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 60px;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--accent-blue);
      text-decoration: none;
    }
    .logo-icon {
      width: 36px; height: 36px;
      background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
      border-radius: var(--radius-sm);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem;
    }
    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }
    .nav-links a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--text-primary); }
    .nav-cta {
      background: var(--accent-green);
      color: white;
      border: none;
      padding: 8px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    .nav-cta:hover { background: var(--accent-green-light); }

    /* ===== HERO ===== */
    .hero {
      text-align: center;
      padding: 60px 24px 40px;
      max-width: 800px;
      margin: 0 auto;
    }
    .hero h1 {
      font-size: 3rem;
      font-weight: 800;
      background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -2px;
      margin-bottom: 12px;
    }
    .hero p {
      color: var(--text-secondary);
      font-size: 1.15rem;
      max-width: 560px;
      margin: 0 auto 28px;
    }
    .hero-badges {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .hero-badge {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    /* ===== STATS BAR ===== */
    .stats-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 24px;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 16px;
      margin-bottom: 20px;
    }
    .stat-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px;
      text-align: center;
      transition: transform 0.2s, border-color 0.2s;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent-blue);
    }
    .stat-card .number {
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent-blue);
    }
    .stat-card .label {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-top: 4px;
    }

    /* ===== OVERALL PROGRESS ===== */
    .progress-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px 24px;
      margin-bottom: 24px;
    }
    .progress-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .progress-card h3 {
      font-size: 1rem;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .progress-bar-bg {
      width: 100%;
      height: 14px;
      background: var(--bg-tertiary);
      border-radius: 7px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent-green), var(--accent-green-light));
      border-radius: 7px;
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 10px;
    }
    .progress-text {
      font-size: 0.9rem;
      color: var(--text-secondary);
    }
    .reset-btn {
      background: var(--bg-tertiary);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      padding: 6px 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-size: 0.8rem;
      transition: all 0.2s;
    }
    .reset-btn:hover {
      background: var(--border);
      color: var(--text-primary);
    }

    /* ===== FILTERS ===== */
    .filters-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 20px;
    }
    .filters {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .filter-btn {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      padding: 8px 18px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .filter-btn:hover {
      background: var(--bg-tertiary);
      color: var(--text-primary);
    }
    .filter-btn.active {
      background: var(--accent-green);
      border-color: var(--accent-green);
      color: white;
    }

    /* ===== TOPICS ===== */
    .topics-section {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 60px;
    }
    .topic-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 16px;
      overflow: hidden;
      transition: border-color 0.2s;
    }
    .topic-card:hover { border-color: var(--border); }
    .topic-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 22px;
      cursor: pointer;
      background: var(--bg-secondary);
      transition: background 0.2s;
      user-select: none;
    }
    .topic-header:hover { background: #1c2128; }
    .topic-title-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .topic-icon {
      width: 42px; height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
    }
    .topic-name {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text-primary);
    }
    .topic-count {
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-left: 8px;
      font-weight: 400;
    }
    .topic-progress-area {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .topic-progress-bar-bg {
      width: 140px;
      height: 8px;
      background: var(--bg-tertiary);
      border-radius: 4px;
      overflow: hidden;
    }
    .topic-progress-bar-fill {
      height: 100%;
      border-radius: 4px;
      transition: width 0.4s;
    }
    .topic-progress-text {
      font-size: 0.85rem;
      color: var(--text-secondary);
      min-width: 50px;
      text-align: right;
    }
    .chevron {
      transition: transform 0.25s;
      color: var(--text-secondary);
      font-size: 0.9rem;
    }
    .chevron.open { transform: rotate(180deg); }

    .problems-list {
      display: none;
      border-top: 1px solid var(--border);
    }
    .problems-list.open { display: block; }

    .problem-row {
      display: flex;
      align-items: center;
      padding: 13px 22px 13px 78px;
      border-bottom: 1px solid var(--bg-tertiary);
      transition: background 0.15s;
    }
    .problem-row:last-child { border-bottom: none; }
    .problem-row:hover { background: #1c2128; }

    .checkbox {
      width: 22px;
      height: 22px;
      border: 2px solid var(--border);
      border-radius: 6px;
      margin-right: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      flex-shrink: 0;
    }
    .checkbox:hover { border-color: var(--accent-green); }
    .checkbox.checked {
      background: var(--accent-green);
      border-color: var(--accent-green);
    }
    .checkbox.checked::after {
      content: "✓";
      color: white;
      font-size: 0.85rem;
      font-weight: bold;
    }

    .problem-name {
      flex: 1;
      font-size: 0.97rem;
      color: var(--text-primary);
      font-weight: 500;
    }
    .problem-name.solved {
      text-decoration: line-through;
      color: var(--text-secondary);
      font-weight: 400;
    }

    .tags {
      display: flex;
      gap: 6px;
      flex-shrink: 0;
    }
    .tag {
      font-size: 0.75rem;
      padding: 3px 10px;
      border-radius: 12px;
      font-weight: 600;
    }
    .tag-v { background: rgba(88, 166, 255, 0.12); color: var(--accent-blue); }
    .tag-h { background: rgba(210, 153, 34, 0.12); color: var(--accent-yellow); }

    .difficulty {
      font-size: 0.78rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 12px;
      margin-left: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .diff-easy { background: rgba(35, 134, 54, 0.12); color: var(--accent-green-light); }
    .diff-medium { background: rgba(210, 153, 34, 0.12); color: var(--accent-yellow); }
    .diff-hard { background: rgba(248, 81, 73, 0.12); color: var(--accent-red); }

    /* ===== FOOTER ===== */
    .footer {
      text-align: center;
      padding: 30px 24px;
      border-top: 1px solid var(--border);
      color: var(--text-secondary);
      font-size: 0.85rem;
    }
    .footer a { color: var(--accent-blue); text-decoration: none; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 768px) {
      .hero h1 { font-size: 2.2rem; }
      .nav-links { display: none; }
      .topic-progress-bar-bg { width: 80px; }
      .problem-row { padding-left: 22px; }
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }

    /* ===== ANIMATIONS ===== */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .topic-card { animation: fadeIn 0.3s ease-out; }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-primary); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #484f58; }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="navbar-inner">
      <a href="#" class="logo">
        <div class="logo-icon">⚡</div>
        HDLForge
      </a>
      <ul class="nav-links">
        <li><a href="#roadmap">Roadmap</a></li>
        <li><a href="#problems">Problems</a></li>
        <li><a href="#about">About</a></li>
      </ul>
      <button class="nav-cta" onclick="scrollToRoadmap()">Start Studying</button>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <h1>A better way to prepare.</h1>
    <p>Hardware design interview roadmaps trusted by engineers at NVIDIA, AMD, Intel, and Apple Silicon.</p>
    <div class="hero-badges">
      <span class="hero-badge">⚡ 86 Practice Problems</span>
      <span class="hero-badge">🔌 Verilog & VHDL</span>
      <span class="hero-badge">📊 Progress Tracking</span>
      <span class="hero-badge">🎯 Interview Focused</span>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-section">
    <div class="stats-grid">
      <div class="stat-card">
        <div class="number" id="stat-total">0</div>
        <div class="label">Total Problems</div>
      </div>
      <div class="stat-card">
        <div class="number" id="stat-solved">0</div>
        <div class="label">Solved</div>
      </div>
      <div class="stat-card">
        <div class="number" id="stat-easy">0</div>
        <div class="label">Easy Left</div>
      </div>
      <div class="stat-card">
        <div class="number" id="stat-medium">0</div>
        <div class="label">Medium Left</div>
      </div>
      <div class="stat-card">
        <div class="number" id="stat-hard">0</div>
        <div class="label">Hard Left</div>
      </div>
    </div>

    <div class="progress-card">
      <div class="progress-card-header">
        <h3>🎯 Overall Progress</h3>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="overall-bar" style="width: 0%"></div>
      </div>
      <div class="progress-meta">
        <span class="progress-text" id="overall-text">0 / 0 solved (0%)</span>
        <button class="reset-btn" onclick="resetProgress()">↺ Reset Progress</button>
      </div>
    </div>
  </section>

  <!-- FILTERS -->
  <section class="filters-section">
    <div class="filters">
      <button class="filter-btn active" onclick="setFilter('all')" id="f-all">All</button>
      <button class="filter-btn" onclick="setFilter('verilog')" id="f-verilog">Verilog</button>
      <button class="filter-btn" onclick="setFilter('vhdl')" id="f-vhdl">VHDL</button>
      <button class="filter-btn" onclick="setFilter('easy')" id="f-easy">Easy</button>
      <button class="filter-btn" onclick="setFilter('medium')" id="f-medium">Medium</button>
      <button class="filter-btn" onclick="setFilter('hard')" id="f-hard">Hard</button>
    </div>
  </section>

  <!-- TOPICS -->
  <section class="topics-section" id="roadmap">
    <div id="topics-container"></div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <p>Built for hardware engineers, by hardware engineers. Open source on <a href="#">GitHub</a>.</p>
    <p style="margin-top:6px; font-size:0.75rem; opacity:0.6;">Progress is saved locally in your browser.</p>
  </footer>

  <script>
    const topics = [
      {
        id: "combinational",
        name: "Combinational Logic",
        desc: "Muxes, decoders, adders, ALUs, and multipliers",
        icon: "🔌",
        color: "#58a6ff",
        problems: [
          { name: "2-to-1 Multiplexer", diff: "easy", tags: ["v","h"] },
          { name: "4-to-1 Multiplexer (using 2-to-1)", diff: "easy", tags: ["v","h"] },
          { name: "8-to-3 Priority Encoder", diff: "easy", tags: ["v","h"] },
          { name: "3-to-8 Decoder", diff: "easy", tags: ["v","h"] },
          { name: "1-bit Full Adder", diff: "easy", tags: ["v","h"] },
          { name: "4-bit Ripple Carry Adder", diff: "easy", tags: ["v","h"] },
          { name: "4-bit Carry Lookahead Adder", diff: "medium", tags: ["v","h"] },
          { name: "4-bit ALU (AND, OR, ADD, SUB)", diff: "medium", tags: ["v","h"] },
          { name: "8-bit Barrel Shifter", diff: "medium", tags: ["v","h"] },
          { name: "BCD to 7-Segment Decoder", diff: "medium", tags: ["v","h"] },
          { name: "16-bit Leading Zero Counter", diff: "hard", tags: ["v","h"] },
          { name: "Wallace Tree Multiplier (4x4)", diff: "hard", tags: ["v","h"] },
        ]
      },
      {
        id: "sequential",
        name: "Sequential Logic",
        desc: "Flip-flops, registers, counters, LFSRs, and clock dividers",
        icon: "⏱️",
        color: "#a371f7",
        problems: [
          { name: "D Flip-Flop (async reset)", diff: "easy", tags: ["v","h"] },
          { name: "D Flip-Flop (sync reset)", diff: "easy", tags: ["v","h"] },
          { name: "T Flip-Flop from D Flip-Flop", diff: "easy", tags: ["v","h"] },
          { name: "JK Flip-Flop", diff: "easy", tags: ["v","h"] },
          { name: "8-bit Register", diff: "easy", tags: ["v","h"] },
          { name: "4-bit Shift Register (SISO)", diff: "easy", tags: ["v","h"] },
          { name: "4-bit Universal Shift Register", diff: "medium", tags: ["v","h"] },
          { name: "4-bit Synchronous Counter", diff: "medium", tags: ["v","h"] },
          { name: "4-bit Johnson Counter", diff: "medium", tags: ["v","h"] },
          { name: "8-bit LFSR (Fibonacci)", diff: "medium", tags: ["v","h"] },
          { name: "Clock Divider (Divide by 3)", diff: "hard", tags: ["v","h"] },
          { name: "Clock Divider (Divide by 5, 50% duty)", diff: "hard", tags: ["v","h"] },
        ]
      },
      {
        id: "fsm",
        name: "Finite State Machines",
        desc: "Moore/Mealy machines, sequence detectors, and protocol controllers",
        icon: "🔄",
        color: "#f0883e",
        problems: [
          { name: "Sequence Detector (1011) — Moore", diff: "easy", tags: ["v","h"] },
          { name: "Sequence Detector (1101) — Mealy", diff: "easy", tags: ["v","h"] },
          { name: "Traffic Light Controller (4-state)", diff: "medium", tags: ["v","h"] },
          { name: "Vending Machine (FSM)", diff: "medium", tags: ["v","h"] },
          { name: "Elevator Controller (2-floor)", diff: "medium", tags: ["v","h"] },
          { name: "UART Transmitter FSM", diff: "medium", tags: ["v","h"] },
          { name: "UART Receiver FSM", diff: "medium", tags: ["v","h"] },
          { name: "SPI Master FSM", diff: "hard", tags: ["v","h"] },
          { name: "I2C Master FSM", diff: "hard", tags: ["v","h"] },
          { name: "DDR Memory Controller FSM", diff: "hard", tags: ["v","h"] },
        ]
      },
      {
        id: "arithmetic",
        name: "Arithmetic Circuits",
        desc: "Multipliers, dividers, CORDIC, and floating-point units",
        icon: "🔢",
        color: "#3fb950",
        problems: [
          { name: "Unsigned Array Multiplier (4x4)", diff: "easy", tags: ["v","h"] },
          { name: "Booth Multiplier (4-bit)", diff: "medium", tags: ["v","h"] },
          { name: "Restoring Division Algorithm", diff: "medium", tags: ["v","h"] },
          { name: "Non-Restoring Division Algorithm", diff: "hard", tags: ["v","h"] },
          { name: "CORDIC (Rotation mode, 8 stages)", diff: "hard", tags: ["v","h"] },
          { name: "Floating Point Adder (IEEE 754)", diff: "hard", tags: ["v","h"] },
          { name: "Floating Point Multiplier", diff: "hard", tags: ["v","h"] },
          { name: "Saturating Adder/Subtractor", diff: "medium", tags: ["v","h"] },
        ]
      },
      {
        id: "memory",
        name: "Memory & FIFOs",
        desc: "SRAM, FIFOs, CAM, and cache controllers",
        icon: "💾",
        color: "#f778ba",
        problems: [
          { name: "Single-Port SRAM (16x8)", diff: "easy", tags: ["v","h"] },
          { name: "Dual-Port SRAM (Async read)", diff: "medium", tags: ["v","h"] },
          { name: "Synchronous FIFO", diff: "medium", tags: ["v","h"] },
          { name: "Asynchronous FIFO (Dual Clock)", diff: "hard", tags: ["v","h"] },
          { name: "LIFO Stack (8-deep)", diff: "medium", tags: ["v","h"] },
          { name: "Content Addressable Memory (CAM)", diff: "hard", tags: ["v","h"] },
          { name: "Cache Controller (Direct Mapped)", diff: "hard", tags: ["v","h"] },
          { name: "Shift Register Queue", diff: "easy", tags: ["v","h"] },
        ]
      },
      {
        id: "pipelining",
        name: "Pipelining & Timing",
        desc: "Pipeline stages, forwarding, hazards, and clock domain techniques",
        icon: "🚰",
        color: "#58a6ff",
        problems: [
          { name: "2-Stage Pipelined Adder", diff: "easy", tags: ["v","h"] },
          { name: "5-Stage Pipelined Multiplier", diff: "medium", tags: ["v","h"] },
          { name: "Pipeline with Forwarding Unit", diff: "hard", tags: ["v","h"] },
          { name: "Pipeline with Hazard Detection", diff: "hard", tags: ["v","h"] },
          { name: "Clock Gating Cell", diff: "medium", tags: ["v","h"] },
          { name: "Positive Edge Detector", diff: "easy", tags: ["v","h"] },
          { name: "Glitch-Free Clock Mux", diff: "hard", tags: ["v","h"] },
          { name: "Async Reset Synchronizer", diff: "medium", tags: ["v","h"] },
        ]
      },
      {
        id: "bus",
        name: "Bus Protocols",
        desc: "APB, AXI, Wishbone, and arbitration logic",
        icon: "🚌",
        color: "#d29922",
        problems: [
          { name: "APB Slave Interface", diff: "easy", tags: ["v","h"] },
          { name: "APB Master Interface", diff: "medium", tags: ["v","h"] },
          { name: "AXI4-Lite Slave", diff: "medium", tags: ["v","h"] },
          { name: "AXI4 Stream Master", diff: "medium", tags: ["v","h"] },
          { name: "Wishbone Master/Slave", diff: "medium", tags: ["v","h"] },
          { name: "AXI4 Full Master (Burst)", diff: "hard", tags: ["v","h"] },
          { name: "AXI Crossbar (2x2)", diff: "hard", tags: ["v","h"] },
          { name: "Arbiter (Round-Robin)", diff: "medium", tags: ["v","h"] },
        ]
      },
      {
        id: "advanced",
        name: "Advanced Topics",
        desc: "CDC, synchronizers, scan chain, and RISC-V cores",
        icon: "🚀",
        color: "#f85149",
        problems: [
          { name: "Clock Domain Crossing (2-FF Sync)", diff: "easy", tags: ["v","h"] },
          { name: "Pulse Synchronizer (CDC)", diff: "medium", tags: ["v","h"] },
          { name: "Handshake Synchronizer", diff: "medium", tags: ["v","h"] },
          { name: "Gray Code Counter (CDC FIFO ptr)", diff: "hard", tags: ["v","h"] },
          { name: "Power Gating Controller", diff: "hard", tags: ["v","h"] },
          { name: "Scan Chain Insertion", diff: "hard", tags: ["v","h"] },
          { name: "JTAG TAP Controller", diff: "hard", tags: ["v","h"] },
          { name: "Simple RISC-V ALU", diff: "medium", tags: ["v","h"] },
          { name: "RISC-V Register File", diff: "medium", tags: ["v","h"] },
          { name: "Simple RISC-V Core (5-stage)", diff: "hard", tags: ["v","h"] },
        ]
      }
    ];

    let solved = new Set(JSON.parse(localStorage.getItem('hdlforge_solved') || localStorage.getItem('neethdl_solved') || '[]'));
    let activeFilter = 'all';

    function getDiffClass(d) {
      return d === 'easy' ? 'diff-easy' : d === 'medium' ? 'diff-medium' : 'diff-hard';
    }
    function getDiffLabel(d) {
      return d === 'easy' ? 'Easy' : d === 'medium' ? 'Medium' : 'Hard';
    }

    function toggleProblem(pid) {
      if (solved.has(pid)) solved.delete(pid);
      else solved.add(pid);
      localStorage.setItem('hdlforge_solved', JSON.stringify([...solved]));
      render();
    }

    function resetProgress() {
      if (confirm('Are you sure you want to reset all progress?')) {
        solved.clear();
        localStorage.setItem('hdlforge_solved', '[]');
        render();
      }
    }

    function setFilter(f) {
      activeFilter = f;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('f-' + f).classList.add('active');
      render();
    }

    function toggleTopic(tid) {
      const el = document.getElementById('plist-' + tid);
      const chev = document.getElementById('chev-' + tid);
      const isOpen = el.classList.contains('open');

      // Close all others (accordion style - optional, remove if you want multiple open)
      document.querySelectorAll('.problems-list').forEach(l => l.classList.remove('open'));
      document.querySelectorAll('.chevron').forEach(c => c.classList.remove('open'));

      if (!isOpen) {
        el.classList.add('open');
        chev.classList.add('open');
      }
    }

    function scrollToRoadmap() {
      document.getElementById('roadmap').scrollIntoView({ behavior: 'smooth' });
    }

    function render() {
      let total = 0, solvedCount = 0, easyLeft = 0, mediumLeft = 0, hardLeft = 0;
      const container = document.getElementById('topics-container');
      container.innerHTML = '';

      topics.forEach((topic, tIdx) => {
        const filtered = topic.problems.filter(p => {
          if (activeFilter === 'all') return true;
          if (activeFilter === 'verilog') return p.tags.includes('v');
          if (activeFilter === 'vhdl') return p.tags.includes('h');
          return p.diff === activeFilter;
        });

        if (filtered.length === 0) return;

        const topicSolved = filtered.filter(p => solved.has(topic.id + '-' + p.name)).length;
        const pct = Math.round((topicSolved / filtered.length) * 100);

        total += filtered.length;
        solvedCount += topicSolved;
        filtered.forEach(p => {
          if (!solved.has(topic.id + '-' + p.name)) {
            if (p.diff === 'easy') easyLeft++;
            if (p.diff === 'medium') mediumLeft++;
            if (p.diff === 'hard') hardLeft++;
          }
        });

        const card = document.createElement('div');
        card.className = 'topic-card';
        card.style.animationDelay = (tIdx * 0.05) + 's';
        card.innerHTML = `
          <div class="topic-header" onclick="toggleTopic('${topic.id}')">
            <div class="topic-title-area">
              <div class="topic-icon" style="background: ${topic.color}18; color: ${topic.color};">${topic.icon}</div>
              <div>
                <div class="topic-name">${topic.name}<span class="topic-count">${filtered.length} problems</span></div>
                <div style="font-size:0.8rem;color:var(--text-secondary);margin-top:2px;">${topic.desc}</div>
              </div>
            </div>
            <div class="topic-progress-area">
              <div class="topic-progress-bar-bg">
                <div class="topic-progress-bar-fill" style="width: ${pct}%; background: ${topic.color};"></div>
              </div>
              <span class="topic-progress-text">${topicSolved}/${filtered.length}</span>
              <span class="chevron" id="chev-${topic.id}">▼</span>
            </div>
          </div>
          <div class="problems-list" id="plist-${topic.id}">
            ${filtered.map(p => {
              const pid = topic.id + '-' + p.name;
              const isSolved = solved.has(pid);
              return `
                <div class="problem-row">
                  <div class="checkbox ${isSolved ? 'checked' : ''}" onclick="event.stopPropagation(); toggleProblem('${pid}')"></div>
                  <span class="problem-name ${isSolved ? 'solved' : ''}">${p.name}</span>
                  <div class="tags">
                    ${p.tags.includes('v') ? '<span class="tag tag-v">Verilog</span>' : ''}
                    ${p.tags.includes('h') ? '<span class="tag tag-h">VHDL</span>' : ''}
                  </div>
                  <span class="difficulty ${getDiffClass(p.diff)}">${getDiffLabel(p.diff)}</span>
                </div>
              `;
            }).join('')}
          </div>
        `;
        container.appendChild(card);
      });

      document.getElementById('stat-total').textContent = total;
      document.getElementById('stat-solved').textContent = solvedCount;
      document.getElementById('stat-easy').textContent = easyLeft;
      document.getElementById('stat-medium').textContent = mediumLeft;
      document.getElementById('stat-hard').textContent = hardLeft;

      const overallPct = total > 0 ? Math.round((solvedCount / total) * 100) : 0;
      document.getElementById('overall-bar').style.width = overallPct + '%';
      document.getElementById('overall-text').textContent = `${solvedCount} / ${total} solved (${overallPct}%)`;
    }

    // Initialize
    render();
  </script>
</body>
</html>